{
  "$schema": "http://interagent.github.io/interagent-hyper-schema",
  "type": [
    "object"
  ],
  "title": "Freshdesk API",
  "description": "Freshdesk API v2 schema for the Rapidi REST WebService connection (Churches Fire)",
  "definitions": {
    "companies": {
      "$schema": "http://json-schema.org/draft-04/hyper-schema",
      "title": "Companies",
      "description": "Freshdesk companies",
      "stability": "production",
      "strictProperties": true,
      "type": [
        "object"
      ],
      "definitions": {
        "id": {
          "description": "Freshdesk company ID.",
          "example": 51000123456,
          "readOnly": true,
          "type": [
            "integer"
          ]
        },
        "name": {
          "description": "Company name (NAV Customer Name). Required, unique.",
          "example": "Whitbread PLC",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "domains": {
          "description": "Company domains. Sending this replaces the whole list.",
          "example": [
            "whitbread.com"
          ],
          "readOnly": false,
          "type": [
            "array"
          ],
          "items": {
            "type": [
              "string"
            ]
          }
        },
        "custom_fields.cu_number": {
          "description": "CU number (NAV Customer No_). Unique.",
          "example": "CU013413",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "custom_fields.key_account": {
          "description": "Key account flag.",
          "example": true,
          "readOnly": false,
          "type": [
            "boolean"
          ]
        },
        "custom_fields.account_manager_code": {
          "description": "NAV salesperson code.",
          "example": "AM01",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "custom_fields.territory_code": {
          "description": "NAV territory code.",
          "example": "SOUTH",
          "readOnly": false,
          "type": [
            "string"
          ]
        }
      },
      "properties": {
        "id": {
          "$ref": "#/definitions/companies/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/companies/definitions/name"
        },
        "domains": {
          "$ref": "#/definitions/companies/definitions/domains"
        },
        "custom_fields.cu_number": {
          "$ref": "#/definitions/companies/definitions/custom_fields.cu_number"
        },
        "custom_fields.key_account": {
          "$ref": "#/definitions/companies/definitions/custom_fields.key_account"
        },
        "custom_fields.account_manager_code": {
          "$ref": "#/definitions/companies/definitions/custom_fields.account_manager_code"
        },
        "custom_fields.territory_code": {
          "$ref": "#/definitions/companies/definitions/custom_fields.territory_code"
        }
      },
      "required": [
        "name"
      ],
      "links": [
        {
          "title": "List",
          "description": "List companies.",
          "href": "/companies",
          "method": "GET",
          "rel": "instances",
          "targetSchema": {
            "type": [
              "array"
            ],
            "items": {
              "$ref": "#/definitions/companies"
            }
          }
        },
        {
          "title": "Create",
          "description": "Create a record in companies.",
          "href": "/companies",
          "method": "POST",
          "rel": "create",
          "schema": {
            "type": [
              "object"
            ],
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/companies/definitions/name"
              },
              "domains": {
                "$ref": "#/definitions/companies/definitions/domains"
              },
              "custom_fields.cu_number": {
                "$ref": "#/definitions/companies/definitions/custom_fields.cu_number"
              },
              "custom_fields.key_account": {
                "$ref": "#/definitions/companies/definitions/custom_fields.key_account"
              },
              "custom_fields.account_manager_code": {
                "$ref": "#/definitions/companies/definitions/custom_fields.account_manager_code"
              },
              "custom_fields.territory_code": {
                "$ref": "#/definitions/companies/definitions/custom_fields.territory_code"
              }
            }
          },
          "targetSchema": {
            "$ref": "#/definitions/companies"
          }
        },
        {
          "title": "Update",
          "description": "Update a record in companies.",
          "href": "/companies/{(%23%2Fdefinitions%2Fcompanies%2Fdefinitions%2Fid)}",
          "method": "PUT",
          "rel": "update",
          "schema": {
            "type": [
              "object"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/companies/definitions/name"
              },
              "domains": {
                "$ref": "#/definitions/companies/definitions/domains"
              },
              "custom_fields.cu_number": {
                "$ref": "#/definitions/companies/definitions/custom_fields.cu_number"
              },
              "custom_fields.key_account": {
                "$ref": "#/definitions/companies/definitions/custom_fields.key_account"
              },
              "custom_fields.account_manager_code": {
                "$ref": "#/definitions/companies/definitions/custom_fields.account_manager_code"
              },
              "custom_fields.territory_code": {
                "$ref": "#/definitions/companies/definitions/custom_fields.territory_code"
              }
            }
          },
          "targetSchema": {
            "$ref": "#/definitions/companies"
          }
        }
      ]
    },
    "contacts": {
      "$schema": "http://json-schema.org/draft-04/hyper-schema",
      "title": "Contacts",
      "description": "Freshdesk contacts",
      "stability": "production",
      "strictProperties": true,
      "type": [
        "object"
      ],
      "definitions": {
        "id": {
          "description": "Freshdesk contact ID.",
          "example": 51000654321,
          "readOnly": true,
          "type": [
            "integer"
          ]
        },
        "name": {
          "description": "Contact name. Required.",
          "example": "John Smith",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "email": {
          "description": "Email, unique across all contacts.",
          "example": "john.smith@whitbread.com",
          "readOnly": false,
          "type": [
            "string"
          ],
          "format": "email"
        },
        "unique_external_id": {
          "description": "NAV contact number (CT no.).",
          "example": "CT0123456",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "phone": {
          "description": "Phone number.",
          "example": "02380 000000",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "mobile": {
          "description": "Mobile number.",
          "example": "07700 900000",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "job_title": {
          "description": "Job title.",
          "example": "Facilities Manager",
          "readOnly": false,
          "type": [
            "string"
          ]
        },
        "company_id": {
          "description": "Freshdesk company ID (number, not the CU number).",
          "example": 51000123456,
          "readOnly": false,
          "type": [
            "integer"
          ]
        }
      },
      "properties": {
        "id": {
          "$ref": "#/definitions/contacts/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/contacts/definitions/name"
        },
        "email": {
          "$ref": "#/definitions/contacts/definitions/email"
        },
        "unique_external_id": {
          "$ref": "#/definitions/contacts/definitions/unique_external_id"
        },
        "phone": {
          "$ref": "#/definitions/contacts/definitions/phone"
        },
        "mobile": {
          "$ref": "#/definitions/contacts/definitions/mobile"
        },
        "job_title": {
          "$ref": "#/definitions/contacts/definitions/job_title"
        },
        "company_id": {
          "$ref": "#/definitions/contacts/definitions/company_id"
        }
      },
      "required": [
        "name"
      ],
      "links": [
        {
          "title": "List",
          "description": "List contacts.",
          "href": "/contacts",
          "method": "GET",
          "rel": "instances",
          "targetSchema": {
            "type": [
              "array"
            ],
            "items": {
              "$ref": "#/definitions/contacts"
            }
          }
        },
        {
          "title": "Create",
          "description": "Create a record in contacts.",
          "href": "/contacts",
          "method": "POST",
          "rel": "create",
          "schema": {
            "type": [
              "object"
            ],
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/contacts/definitions/name"
              },
              "email": {
                "$ref": "#/definitions/contacts/definitions/email"
              },
              "unique_external_id": {
                "$ref": "#/definitions/contacts/definitions/unique_external_id"
              },
              "phone": {
                "$ref": "#/definitions/contacts/definitions/phone"
              },
              "mobile": {
                "$ref": "#/definitions/contacts/definitions/mobile"
              },
              "job_title": {
                "$ref": "#/definitions/contacts/definitions/job_title"
              },
              "company_id": {
                "$ref": "#/definitions/contacts/definitions/company_id"
              }
            }
          },
          "targetSchema": {
            "$ref": "#/definitions/contacts"
          }
        },
        {
          "title": "Update",
          "description": "Update a record in contacts.",
          "href": "/contacts/{(%23%2Fdefinitions%2Fcontacts%2Fdefinitions%2Fid)}",
          "method": "PUT",
          "rel": "update",
          "schema": {
            "type": [
              "object"
            ],
            "properties": {
              "name": {
                "$ref": "#/definitions/contacts/definitions/name"
              },
              "email": {
                "$ref": "#/definitions/contacts/definitions/email"
              },
              "unique_external_id": {
                "$ref": "#/definitions/contacts/definitions/unique_external_id"
              },
              "phone": {
                "$ref": "#/definitions/contacts/definitions/phone"
              },
              "mobile": {
                "$ref": "#/definitions/contacts/definitions/mobile"
              },
              "job_title": {
                "$ref": "#/definitions/contacts/definitions/job_title"
              },
              "company_id": {
                "$ref": "#/definitions/contacts/definitions/company_id"
              }
            }
          },
          "targetSchema": {
            "$ref": "#/definitions/contacts"
          }
        }
      ]
    }
  },
  "properties": {
    "companies": {
      "$ref": "#/definitions/companies"
    },
    "contacts": {
      "$ref": "#/definitions/contacts"
    }
  },
  "links": [
    {
      "href": "https://churchesfiresandbox.freshdesk.com/api/v2",
      "rel": "self"
    }
  ]
}
