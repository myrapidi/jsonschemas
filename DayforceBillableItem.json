  "description": "Content schema to read and write Aimsio API data. Each top-level definition matches its Aimsio endpoint name exactly.",
  "type": ["object"],
  "definitions": {
    "BillableItem": {
      "description": "Billable Item records in Aimsio.",
      "$schema": "http://json-schema.org/draft-06/hyper-schema#",
      "stability": "beta",
      "strictProperties": true,
      "title": "BillableItem",
      "type": ["object"],
      "definitions": {
        "billableItemGuid": {
          "description": "Unique identifier automatically generated by the Aimsio system. Only used to update an existing object.",
          "example": "587bbf61-0d55-4098-9470-0ae1a71cd41b",
          "readOnly": true,
          "type": ["string"]
        },
        "billableItemCode": {
          "description": "Unique identifier, visible to end users. Required for creating or updating an object.",
          "example": "ACC-CAMP",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemName": {
          "description": "Display name of the billable item. Required for creating or updating an object.",
          "example": "Camp Accommodation",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemTypeUname": {
          "description": "Unique name code for the billable item type. Required when creating a new object. Either billableItemTypeUname or billableItemTypeName is required.",
          "example": "accommodation",
          "readOnly": false,
          "type": ["string"],
          "enum": [
            "labour",
            "equipment",
            "material",
            "service",
            "unit_billing",
            "per_diem",
            "accommodation",
            "mileage",
            "surcharge"
          ]
        },
        "billableItemTypeName": {
          "description": "Display name for the billable item type. Required when creating a new object. Either billableItemTypeUname or billableItemTypeName is required.",
          "example": "Accommodation",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemIsTrade": {
          "description": "Set to true if billableItemTypeName = 'Labour'. Required for creating or updating an object.",
          "example": false,
          "readOnly": false,
          "type": ["boolean"]
        },
        "billableItemIsEquipment": {
          "description": "Set to true if billableItemTypeName = 'Equipment'. Required for creating or updating an object.",
          "example": false,
          "readOnly": false,
          "type": ["boolean"]
        },
        "billableItemCategory": {
          "description": "Category assigned to the billable item.",
          "example": "",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDescription": {
          "description": "Description of the billable item.",
          "example": "Camp charges for full lodging, meals, etc.",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemStatus": {
          "description": "Status of the billable item.",
          "example": "Camp",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultRate": {
          "description": "Default billing rate. Required when creating a new object.",
          "example": 1050.0,
          "readOnly": false,
          "type": ["number"]
        },
        "billableItemDefaultRateType": {
          "description": "Display name for the default rate's unit type (e.g., Hourly, Daily, Each). Required when creating a new object. Either billableItemDefaultRateType or billableItemDefaultRateTypeUname is required.",
          "example": "Each",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultRateTypeUname": {
          "description": "Unique name code for the default rate's unit type. Either billableItemDefaultRateType or billableItemDefaultRateTypeUname is required.",
          "example": "each",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultRate2": {
          "description": "Second default billing rate.",
          "example": 850.0,
          "readOnly": false,
          "type": ["number"]
        },
        "billableItemDefaultRateType2": {
          "description": "Display name for the second rate's unit type. If billableItemDefaultRate2 is provided, either billableItemDefaultRateType2 or billableItemDefaultRateTypeUname2 is required.",
          "example": "Daily",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultRateTypeUname2": {
          "description": "Unique name code for the second rate's unit type. If billableItemDefaultRate2 is provided, either billableItemDefaultRateType2 or billableItemDefaultRateTypeUname2 is required.",
          "example": "daily",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultRate3": {
          "description": "Third default billing rate.",
          "example": 275.0,
          "readOnly": false,
          "type": ["number"]
        },
        "billableItemDefaultRateType3": {
          "description": "Display name for the third rate's unit type. If billableItemDefaultRate3 is provided, either billableItemDefaultRateType3 or billableItemDefaultRateTypeUname3 is required.",
          "example": "Hourly",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultRateTypeUname3": {
          "description": "Unique name code for the third rate's unit type. If billableItemDefaultRate3 is provided, either billableItemDefaultRateType3 or billableItemDefaultRateTypeUname3 is required.",
          "example": "hourly",
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemDefaultCost": {
          "description": "Default cost rate. Cost rates are only available for certain customer tiers.",
          "example": 525.0,
          "readOnly": false,
          "type": ["number"]
        },
        "billableItemDefaultCost2": {
          "description": "Second default cost rate. Cost rates are only available for certain customer tiers.",
          "example": null,
          "readOnly": false,
          "type": ["number"]
        },
        "billableItemDefaultCost3": {
          "description": "Third default cost rate. Cost rates are only available for certain customer tiers.",
          "example": null,
          "readOnly": false,
          "type": ["number"]
        },
        "billableItemGlAccountNumber": {
          "description": "Applicable to accounts with GL Account master data enabled. Must be an existing GL Account number.",
          "example": null,
          "readOnly": false,
          "type": ["string"]
        },
        "billableItemGlAccountInfo": {
          "description": "Read-only descriptive information about the linked GL account.",
          "example": null,
          "readOnly": true,
          "type": ["string"]
        },
        "billableItemCreatedAt": {
          "description": "Timestamp the record was created, in epoch milliseconds.",
          "example": 1687892271809,
          "readOnly": true,
          "type": ["integer"]
        },
        "billableItemCreatedByUserName": {
          "description": "Username of the user who created the record.",
          "example": "admin@concorde-sandbox",
          "readOnly": true,
          "type": ["string"]
        },
        "billableItemCreatedByFullName": {
          "description": "Full name of the user who created the record.",
          "example": "Aimsio Concorde",
          "readOnly": true,
          "type": ["string"]
        },
        "billableItemUpdatedAt": {
          "description": "Timestamp the record was last updated, in epoch milliseconds.",
          "example": 1736872573916,
          "readOnly": false,
          "type": ["integer"]
        },
        "billableItemLastModifiedByUserName": {
          "description": "Username of the user who last modified the record.",
          "example": "admin@concorde-sandbox",
          "readOnly": true,
          "type": ["string"]
        },
        "billableItemLastModifiedByFullName": {
          "description": "Full name of the user who last modified the record.",
          "example": "Aimsio Concorde",
          "readOnly": true,
          "type": ["string"]
        },
        "billableItemIsDeleted": {
          "description": "Indicates whether the billable item has been deleted.",
          "example": false,
          "readOnly": false,
          "type": ["boolean"]
        }
