{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "https://myrapidi.github.io/jsonschemas/stripe_payment_intents#",
  "title": "Stripe Payment Intents and Customers (Events gather + backfill + customers)",
  "description": "Read succeeded Stripe Payment Intents (via events gather + backfill) and Stripe Customers. See per-table descriptions for details.",
  "type": [
    "object"
  ],
  "definitions": {
    "context": {
      "$schema": "http://json-schema.org/draft-04/hyper-schema",
      "title": "Connection Context",
      "description": "Connection variables for Stripe REST API.",
      "stability": "stable",
      "strictProperties": true,
      "type": [
        "object"
      ],
      "definitions": {
        "base_url": {
          "description": "Stripe API base URL.",
          "example": "https://api.stripe.com",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "api_version": {
          "description": "Stripe API version.",
          "example": "v1",
          "readOnly": true,
          "type": [
            "string"
          ]
        }
      },
      "properties": {
        "base_url": {
          "$ref": "#/definitions/context/definitions/base_url"
        },
        "api_version": {
          "$ref": "#/definitions/context/definitions/api_version"
        }
      }
    },
    "customer": {
      "$schema": "http://json-schema.org/draft-04/hyper-schema",
      "title": "Customer",
      "description": "Stripe Customer, flat table. 'email' is the join key to HubSpot's unique contact email; check for an existing Stripe customer before creating a new one.",
      "stability": "stable",
      "strictProperties": true,
      "type": [
        "object"
      ],
      "definitions": {
        "id": {
          "description": "Customer ID (cus_...). Write back to HubSpot as stripe_customer_id; referenced by PaymentIntent.customer.",
          "example": "cus_UlJBMMGCVNDQxk",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "email": {
          "description": "Customer's email address. Join key back to the HubSpot contact (case-sensitive on Stripe's side; HubSpot enforces uniqueness, Stripe does not).",
          "example": "student@example.com",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Customer's full name or business name.",
          "example": "Jenny Rosen",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "description": "Arbitrary string attached to the customer. Displayed in the Stripe Dashboard.",
          "example": "WSE student - synced from HubSpot",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "description": "Customer's phone number.",
          "example": "+34600000000",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "description": "Unix timestamp of when the Customer was created. Source-control watermark. x-rapidi-sourceControl sends 'created[gte]=<watermark>' on /v1/customers.",
          "example": 1782315588,
          "readOnly": true,
          "type": [
            "integer"
          ],
          "x-rapidi-sourceControl": "created[gte]="
        },
        "currency": {
          "description": "Three-letter ISO currency code (lowercase) the customer is billed in for recurring billing purposes. Null until the customer has a billing event.",
          "example": "eur",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "balance": {
          "description": "Current balance stored on the customer in their default currency (smallest currency unit). Negative = credit, positive = amount owed on next invoice.",
          "example": 0,
          "readOnly": true,
          "type": [
            "integer"
          ]
        },
        "delinquent": {
          "description": "Tracks the most recent payment state on any invoice belonging to the customer. True if an automatic payment failed or an invoice passed its due date.",
          "example": false,
          "readOnly": true,
          "type": [
            "boolean",
            "null"
          ]
        },
        "address": {
          "description": "Customer's address (line1, line2, city, state, postal_code, country). Nested object - flatten as needed downstream.",
          "example": {
            "city": "Santa Cruz de Tenerife",
            "country": "ES",
            "line1": "",
            "line2": null,
            "postal_code": "",
            "state": ""
          },
          "readOnly": true,
          "type": [
            "object",
            "null"
          ]
        },
        "invoice_prefix": {
          "description": "Prefix used to generate this customer's unique invoice numbers.",
          "example": "0759376C",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "default_source": {
          "description": "Default payment source (legacy Sources/Cards API). Prefer invoice_settings_default_payment_method if on PaymentMethods API.",
          "example": "card_1TlstzHR2udh1uZx5adUS2sv",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "invoice_settings_default_payment_method": {
          "description": "PaymentMethod (pm_...) used by default for auto-charging. Modern equivalent of default_source.",
          "example": "pm_1TlstzHR2udh1uZx5adUS2sv",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "discount": {
          "description": "Active discount/coupon, if any. Reduces the amount actually charged - factor into BC reconciliation.",
          "example": null,
          "readOnly": true,
          "type": [
            "object",
            "null"
          ]
        },
        "hubspot_contact_id": {
          "description": "HubSpot Contact ID, flattened from metadata['hubspot_contact_id']. Writable; set on create/update. Filterable via Search.",
          "example": "12345678901",
          "readOnly": false,
          "type": [
            "string",
            "null"
          ]
        },
        "tax_exempt": {
          "description": "Customer's tax exemption status: none, exempt, or reverse.",
          "example": "none",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "livemode": {
          "description": "Whether the Customer was created in live mode or test mode.",
          "example": false,
          "readOnly": true,
          "type": [
            "boolean"
          ]
        },
        "metadata": {
          "description": "Set of key-value pairs attached to the object. Use this to store the HubSpot contact ID at creation time for a two-way reference.",
          "example": {},
          "readOnly": true,
          "type": [
            "object"
          ]
        }
      },
      "properties": {
        "id": {
          "$ref": "#/definitions/customer/definitions/id"
        },
        "email": {
          "$ref": "#/definitions/customer/definitions/email"
        },
        "name": {
          "$ref": "#/definitions/customer/definitions/name"
        },
        "description": {
          "$ref": "#/definitions/customer/definitions/description"
        },
        "phone": {
          "$ref": "#/definitions/customer/definitions/phone"
        },
        "created": {
          "$ref": "#/definitions/customer/definitions/created"
        },
        "currency": {
          "$ref": "#/definitions/customer/definitions/currency"
        },
        "balance": {
          "$ref": "#/definitions/customer/definitions/balance"
        },
        "delinquent": {
          "$ref": "#/definitions/customer/definitions/delinquent"
        },
        "address": {
          "$ref": "#/definitions/customer/definitions/address"
        },
        "invoice_prefix": {
          "$ref": "#/definitions/customer/definitions/invoice_prefix"
        },
        "default_source": {
          "$ref": "#/definitions/customer/definitions/default_source"
        },
        "invoice_settings_default_payment_method": {
          "$ref": "#/definitions/customer/definitions/invoice_settings_default_payment_method"
        },
        "discount": {
          "$ref": "#/definitions/customer/definitions/discount"
        },
        "hubspot_contact_id": {
          "$ref": "#/definitions/customer/definitions/hubspot_contact_id"
        },
        "tax_exempt": {
          "$ref": "#/definitions/customer/definitions/tax_exempt"
        },
        "livemode": {
          "$ref": "#/definitions/customer/definitions/livemode"
        },
        "metadata": {
          "$ref": "#/definitions/customer/definitions/metadata"
        }
      },
      "links": [
        {
          "title": "List",
          "description": "List Customers, most recent first (rel=instances). Filter by email for a targeted HubSpot match.",
          "href": "/v1/customers",
          "method": "GET",
          "rel": "instances",
          "schema": {
            "type": [
              "object"
            ],
            "properties": {
              "email": {
                "description": "OPTIONAL FILTER. Case-sensitive exact match on customer email. Use for a targeted lookup instead of paging the full list.",
                "example": "student@example.com",
                "type": [
                  "string"
                ]
              },
              "created[gte]": {
                "description": "SOURCE CONTROL: only Customers created at/after the watermark.",
                "example": 1782315588,
                "type": [
                  "integer"
                ]
              },
              "limit": {
                "description": "Maximum number of records to return (1-100).",
                "example": 100,
                "type": [
                  "integer"
                ]
              },
              "starting_after": {
                "description": "Cursor for pagination - last Customer ID from previous page.",
                "example": "cus_UlJBMMGCVNDQxk",
                "type": [
                  "string"
                ]
              }
            }
          },
          "targetSchema": {
            "type": [
              "array"
            ],
            "items": {
              "$ref": "#/definitions/customer"
            }
          }
        },
        {
          "title": "Search",
          "description": "Search Customers on fields List doesn't support (name, phone, metadata). Eventually consistent - don't use right after a create; use List+email for dedup checks instead.",
          "href": "/v1/customers/search",
          "method": "GET",
          "rel": "search",
          "schema": {
            "type": [
              "object"
            ],
            "properties": {
              "query": {
                "description": "Stripe Search Query Language. Supported: email, name, phone, metadata['key']. AND only, no parentheses.",
                "example": "name:'Jane Doe' AND metadata['hubspot_contact_id']:'12345'",
                "type": [
                  "string"
                ]
              },
              "limit": {
                "description": "Maximum number of records to return (1-100).",
                "example": 100,
                "type": [
                  "integer"
                ]
              },
              "page": {
                "description": "Pagination cursor. Omit on the first call; use the next_page value from the previous response for subsequent pages.",
                "example": "eyJwYWdlIjogMX0",
                "type": [
                  "string"
                ]
              }
            },
            "required": [
              "query"
            ]
          },
          "targetSchema": {
            "type": [
              "array"
            ],
            "items": {
              "$ref": "#/definitions/customer"
            }
          }
        }
      ]
    },
    "event": {
      "$schema": "http://json-schema.org/draft-04/hyper-schema",
      "title": "Payment Intent Event (gather header)",
      "description": "HEADER table for the gather: one row per payment_intent.succeeded event. The PaymentIntent itself is the child table 'data'.",
      "stability": "stable",
      "strictProperties": true,
      "type": [
        "object"
      ],
      "definitions": {
        "id": {
          "description": "Event ID (evt_...). Reference / dedup key for the header row.",
          "example": "evt_3Tlsu0HR2udh1uZx1a2b3c4d",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "created": {
          "description": "Event creation timestamp - the source-control watermark. This is the EVENT clock, not the PaymentIntent's own created field.",
          "example": 1782315588,
          "readOnly": true,
          "type": [
            "integer"
          ],
          "x-rapidi-sourceControl": "created[gte]="
        },
        "type": {
          "description": "Event type, always payment_intent.succeeded (set via the type query filter).",
          "example": "payment_intent.succeeded",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "data": {
          "description": "Holder for the gathered PaymentIntent child (event.data.object). Not a scalar.",
          "type": [
            "object"
          ]
        }
      },
      "properties": {
        "id": {
          "$ref": "#/definitions/event/definitions/id"
        },
        "created": {
          "$ref": "#/definitions/event/definitions/created"
        },
        "type": {
          "$ref": "#/definitions/event/definitions/type"
        },
        "data": {
          "$ref": "#/definitions/event/definitions/data"
        }
      },
      "links": [
        {
          "title": "List",
          "description": "Read succeeded PaymentIntent events incrementally (rel=instances). Gathers data.object into the child table 'data'.",
          "href": "/v1/events",
          "method": "GET",
          "rel": "instances",
          "schema": {
            "type": [
              "object"
            ],
            "properties": {
              "type": {
                "description": "STATUS FILTER. Configure a filter type=payment_intent.succeeded. 'type' is a real /v1/events parameter, rendered by the existing raw filter passthrough.",
                "example": "payment_intent.succeeded",
                "type": [
                  "string"
                ]
              },
              "created[gte]": {
                "description": "SOURCE CONTROL: only events created at/after the stored watermark.",
                "example": 1782315588,
                "type": [
                  "integer"
                ]
              },
              "limit": {
                "description": "Maximum number of events to return (1-100).",
                "example": 100,
                "type": [
                  "integer"
                ]
              },
              "starting_after": {
                "description": "Cursor for paging within one run - last event ID from previous page.",
                "example": "evt_3Tlsu0HR2udh1uZx1a2b3c4d",
                "type": [
                  "string"
                ]
              }
            }
          },
          "targetSchema": {
            "type": [
              "array"
            ],
            "items": {
              "$ref": "#/definitions/event"
            }
          }
        }
      ]
    },
    "data": {
      "$schema": "http://json-schema.org/draft-04/hyper-schema",
      "title": "Payment Intent (gathered child)",
      "description": "CHILD table gathered from 'event'. Definition name matches event.data so the connector's gather locates it automatically.",
      "stability": "stable",
      "strictProperties": true,
      "type": [
        "object"
      ],
      "parentObject": {
        "event": {
          "$ref": "#/definitions/event/definitions/data"
        }
      },
      "definitions": {
        "id": {
          "description": "Unique identifier for the Payment Intent (pi_...). From data.object.id.",
          "example": "pi_3Tlsu0HR2udh1uZx0U7oUS3b",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "amount": {
          "description": "Amount intended to be collected, in the smallest currency unit (e.g. cents). Divide by 100 for BC.",
          "example": 99,
          "readOnly": true,
          "type": [
            "integer"
          ]
        },
        "amount_received": {
          "description": "Amount that was collected, in the smallest currency unit.",
          "example": 99,
          "readOnly": true,
          "type": [
            "integer"
          ]
        },
        "currency": {
          "description": "Three-letter ISO currency code, lowercase. Convert to uppercase for BC.",
          "example": "eur",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "status": {
          "description": "Payment Intent status. Always 'succeeded' here (guaranteed by the event type filter).",
          "example": "succeeded",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "created": {
          "description": "PaymentIntent's own created timestamp (data.object.created). Use for BC Posting Date - not the source-control watermark.",
          "example": 1782315500,
          "readOnly": true,
          "type": [
            "integer"
          ]
        },
        "customer": {
          "description": "Stripe Customer ID (cus_...). Used to look up BC Customer No.",
          "example": "cus_UlJBMMGCVNDQxk",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "description": {
          "description": "Description of the payment. Maps to BC Payment Journal Description.",
          "example": "Consultancy hours",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "latest_charge": {
          "description": "ID of the most recent charge (ch_...). Can be used as BC Document No.",
          "example": "ch_3Tlsu0HR2udh1uZx0ZbNUCLS",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "statement_descriptor": {
          "description": "Statement descriptor shown on customer's bank statement.",
          "example": "Consultancy hours",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_email": {
          "description": "Email address that the receipt was sent to.",
          "example": "customer@example.com",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "livemode": {
          "description": "Whether the Payment Intent was created in live mode or test mode.",
          "example": false,
          "readOnly": true,
          "type": [
            "boolean"
          ]
        },
        "capture_method": {
          "description": "Capture method used: automatic or manual.",
          "example": "automatic",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "payment_method": {
          "description": "ID of the payment method used (pm_...).",
          "example": "pm_1TlstzHR2udh1uZx5adUS2sv",
          "readOnly": true,
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "description": "Set of key-value pairs attached to the object. May contain HubSpot or BC customer references.",
          "example": {},
          "readOnly": true,
          "type": [
            "object"
          ]
        }
      },
      "properties": {
        "id": {
          "$ref": "#/definitions/data/definitions/id"
        },
        "amount": {
          "$ref": "#/definitions/data/definitions/amount"
        },
        "amount_received": {
          "$ref": "#/definitions/data/definitions/amount_received"
        },
        "currency": {
          "$ref": "#/definitions/data/definitions/currency"
        },
        "status": {
          "$ref": "#/definitions/data/definitions/status"
        },
        "created": {
          "$ref": "#/definitions/data/definitions/created"
        },
        "customer": {
